# AutoBuilder Configuration
# -------------------------

# Git repository to clone, build, and watch for changes
SERVICE_GIT_REPO='https://github.com/yourusername/your-repo.git'

# Branch to track (default: main)
SERVICE_GIT_BRANCH='main'

# Optional: Personal access token for private repos
SERVICE_GIT_TOKEN=''

# Port the application listens on inside the container
SERVICE_PORT='3000'

# Port to expose on the host
SERVICE_HOST_PORT='5050'

# Optional: Override the built image tag
SERVICE_IMAGE_NAME='autobuilder:latest'

# Optional: Override the container start command (overrides Dockerfile CMD)
SERVICE_COMMAND=''

# Environment Variable Passthrough
# ---------------------------------
# RUNTIME_ENV_PASSTHROUGH — patterns for vars injected into the running container
#   Default: '*' (everything). Use 'MYAPP_* DATABASE_*' to restrict.
# BUILD_ARGS — patterns for vars passed as --build-arg during docker build
#   Default: 'VITE_* NEXT_* PUBLIC_* REACT_* NUKS_*'

# RUNTIME_ENV_PASSTHROUGH='*'
# BUILD_ARGS='VITE_* NEXT_*'

# Application-specific variables (examples)
# VITE_API_URL='https://api.example.com'
# DATABASE_URL='postgres://...'
