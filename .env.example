# AutoBuilder Service Configuration
# ---------------------------------
# Per-deployment config lives in deployments/<name>/{service.json,.env}.
# This file is only for service-wide defaults (rarely needs editing).

# Seconds between git polls in each updater sidecar
POLL_INTERVAL='60'

# Absolute host path of ./deployments. Used to translate relative volume mounts
# in deployment specs into docker-resolvable host paths. Auto-populated by
# prepare.sh — you should not need to edit this manually.
DEPLOYMENTS_HOST_PATH=''
