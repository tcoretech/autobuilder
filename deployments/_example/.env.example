# AutoBuilder deployment — app env vars
# --------------------------------------
# These are passed to the running container via `env_file:` in the generated
# docker-compose.yml. No stripping, no filtering — what you put here is what
# the app sees at runtime.
#
# A subset of these can also be baked into the built image at build time by
# listing them under `build.args` in service.json (useful for frontend
# frameworks that inline env vars at compile time — VITE_*, NEXT_PUBLIC_*, etc.)

# VITE_API_URL='https://api.example.com'
# DATABASE_URL='postgres://user:pass@postgres:5432/mydb'
# NEXT_PUBLIC_SITE_URL='https://example.com'
